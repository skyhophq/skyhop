#!/bin/sh
# Stand-in for the claude CLI, so tests never reach the real cloud.
if [ "$1" = "auth" ]; then
  if [ "$FAKE_CLAUDE_MODE" = "signed-out" ]; then
    echo '{"loggedIn":false}'
  else
    echo '{"loggedIn":true,"authMethod":"claude.ai"}'
  fi
  exit 0
fi

if [ "$1" = "agents" ]; then
  echo "${FAKE_CLAUDE_AGENTS:-[]}"
  exit 0
fi

# claude -p --resume <id> ...: the resumed session inside the VM. It reports one step,
# works for FAKE_INNER_SECONDS, then replies.
if [ "$1" = "-p" ] && [ "$2" = "--resume" ]; then
  cat > "$FAKE_CLAUDE_DIR/inner-prompt"
  printf '%s' "$SKYHOP_INNER" > "$FAKE_CLAUDE_DIR/inner-env"
  echo '{"type":"system","subtype":"init"}'
  echo '{"type":"assistant","message":{"content":[{"type":"tool_use","name":"Bash","input":{"command":"npm test"}}]}}'
  sleep "${FAKE_INNER_SECONDS:-0}"
  echo '{"type":"result","result":"fake inner reply"}'
  exit 0
fi

# claude -p --cloud <id> --output-format json: posts a message into an existing chat.
if [ "$1" = "-p" ] && [ "$2" = "--cloud" ]; then
  if [ "$FAKE_CLAUDE_SEND" = "archived" ]; then
    echo "{\"ok\":false,\"session_id\":\"$3\",\"error\":\"cloud session $3 is archived and cannot accept new messages\"}"
    exit 1
  fi
  cat > "$FAKE_CLAUDE_DIR/prompt"
  printf '%s' "$3" > "$FAKE_CLAUDE_DIR/sent-to"
  echo "{\"ok\":true,\"session_id\":\"$3\",\"url\":\"https://claude.ai/code/$3\"}"
  exit 0
fi

if [ "$1" = "--cloud" ]; then
  if ! [ -t 0 ]; then
    echo "Error: --cloud requires an interactive terminal."
    exit 1
  fi
  printf '%s' "$2" > "$FAKE_CLAUDE_DIR/prompt"
  git rev-parse --abbrev-ref HEAD > "$FAKE_CLAUDE_DIR/branch"
  printf '%s' "${CCR_FORCE_BUNDLE:-unset}" > "$FAKE_CLAUDE_DIR/force-bundle"
  git show HEAD:tracked.txt > "$FAKE_CLAUDE_DIR/launch-tracked" 2>/dev/null
  git show HEAD:.skyhop/mode > "$FAKE_CLAUDE_DIR/relay-mode" 2>/dev/null
  git show HEAD:.skyhop/session-id > "$FAKE_CLAUDE_DIR/relay-session" 2>/dev/null
  git clone -q "$PWD" "$FAKE_CLAUDE_DIR/vm" 2>/dev/null
  if origin=$(git remote get-url origin 2>/dev/null); then
    git -C "$FAKE_CLAUDE_DIR/vm" remote set-url origin "$origin"
  else
    git -C "$FAKE_CLAUDE_DIR/vm" remote remove origin
  fi
  case "$FAKE_CLAUDE_MODE" in
    trust)
      printf 'Quick\033[1Csafety\033[1Ccheck: Is\033[1Cthis\033[1Ca\033[1Cproject\033[1Cyou\033[1Ccreated\n'
      printf 'Yes,\033[1CI\033[1Ctrust\033[1Cthis\033[1Cfolder\n'
      ;;
    wrong-branch)
      echo "Branch skyhop/x is not on GitHub. Starting from the default branch."
      ;;
    no-link)
      echo "Setting up"
      exit 0
      ;;
    *)
      echo "View: https://claude.ai/code/session_01FakeSessionForTests"
      ;;
  esac
  sleep 30
fi
